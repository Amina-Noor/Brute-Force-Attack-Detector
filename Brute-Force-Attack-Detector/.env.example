# Brute Force Attack Detector - Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# Default failed-login threshold before an alert is raised
FAILED_THRESHOLD=5

# Default sliding time window (minutes) used for threshold-based detection
TIME_WINDOW_MINUTES=5

# Directory where generated reports (CSV/MD/HTML) are saved
EXPORT_DIRECTORY=reports

# Enable verbose debug logging (true/false)
DEBUG=false
